{
  "openapi": "3.1.0",
  "info": {
    "title": "CareerLens API",
    "version": "1.0.0",
    "description": "Session-authenticated HTTP API for the CareerLens web application."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "api_health_health",
        "summary": "Health check probe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "error"
                }
              }
            }
          }
        },
        "description": "Unauthenticated probe for load balancers and uptime monitors. Returns 200 when the application and dependencies are healthy, 503 when unavailable.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "config_api_v1_accounts_me",
        "summary": "Current session user",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Ensures the CSRF cookie is available for subsequent state-changing requests.",
                "schema": {
                  "type": "string"
                },
                "example": "csrftoken=token; Path=/; SameSite=Lax"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Unauthorized"
                }
              }
            }
          }
        },
        "description": "Returns the profile of the currently authenticated user.\n\nAlso ensures the CSRF token is available: the response carries a\n`Set-Cookie: csrftoken` header that clients must store and echo back\nas `X-CSRFToken` on subsequent state-changing requests.",
        "tags": [
          "accounts"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/logout": {
      "post": {
        "operationId": "config_api_v1_accounts_logout",
        "summary": "Log out",
        "parameters": [
          {
            "in": "cookie",
            "name": "csrftoken",
            "schema": {
              "description": "CSRF cookie issued by GET /api/v1/me.",
              "title": "Csrftoken",
              "type": "string"
            },
            "required": true,
            "description": "CSRF cookie issued by GET /api/v1/me."
          },
          {
            "in": "header",
            "name": "X-CSRFToken",
            "schema": {
              "description": "Value matching the csrftoken cookie.",
              "title": "X-Csrftoken",
              "type": "string"
            },
            "required": true,
            "description": "Value matching the csrftoken cookie."
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the Django session cookie.",
                "schema": {
                  "type": "string"
                },
                "example": "sessionid=; Max-Age=0; Path=/; SameSite=Lax"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "CSRF check Failed"
                }
              }
            }
          }
        },
        "description": "Terminates the current authenticated session and clears the session cookie.\n\nRequires the `X-CSRFToken` header matching the `csrftoken` cookie value.",
        "tags": [
          "accounts"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/feed": {
      "get": {
        "operationId": "config_api_v1_feed_feed",
        "summary": "List vacancies",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "One-based page number.",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            },
            "required": false,
            "description": "One-based page number."
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Items per page, capped at 100.",
              "title": "Page Size"
            },
            "required": false,
            "description": "Items per page, capped at 100."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedOut"
                },
                "example": {
                  "items": [
                    {
                      "id": 42,
                      "title": "Python Developer",
                      "company": "Acme",
                      "location": "Remote",
                      "posted_date": "2026-08-21",
                      "source": {
                        "code": "dou",
                        "name": "DOU"
                      },
                      "url": "https://example.com/jobs/42"
                    }
                  ],
                  "count": 1
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Unauthorized"
                }
              }
            }
          }
        },
        "description": "Returns vacancies in stable newest-first order.",
        "tags": [
          "feed"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "examples": [
          {
            "status": "ok"
          }
        ],
        "properties": {
          "status": {
            "description": "Overall application and dependency health.",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeOut": {
        "examples": [
          {
            "avatar_url": "https://images.example.com/john.jpg",
            "email": "john.doe@example.com",
            "first_name": "John",
            "id": 1,
            "last_name": "Doe"
          }
        ],
        "properties": {
          "id": {
            "description": "CareerLens user identifier.",
            "title": "Id",
            "type": "integer"
          },
          "email": {
            "description": "Verified sign-in email address.",
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "description": "Given name, or an empty string when unavailable.",
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "description": "Family name, or an empty string when unavailable.",
            "title": "Last Name",
            "type": "string"
          },
          "avatar_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "WorkOS profile image URL, or null when unavailable.",
            "title": "Avatar Url"
          }
        },
        "required": [
          "id",
          "email",
          "first_name",
          "last_name",
          "avatar_url"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ErrorOut": {
        "examples": [
          {
            "detail": "Unauthorized"
          }
        ],
        "properties": {
          "detail": {
            "description": "Human-readable reason the request was rejected.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "Input": {
        "properties": {
          "page": {
            "default": 1,
            "description": "One-based page number.",
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Items per page, capped at 100.",
            "title": "Page Size"
          }
        },
        "title": "Input",
        "type": "object"
      },
      "FeedOut": {
        "properties": {
          "items": {
            "description": "Vacancies on the requested page.",
            "items": {
              "$ref": "#/components/schemas/VacancyOut"
            },
            "title": "Items",
            "type": "array"
          },
          "count": {
            "description": "Total number of vacancies.",
            "title": "Count",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "count"
        ],
        "title": "FeedOut",
        "type": "object"
      },
      "SourceOut": {
        "properties": {
          "code": {
            "description": "Stable source code.",
            "title": "Code",
            "type": "string"
          },
          "name": {
            "description": "Human-readable source name.",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "VacancyOut": {
        "examples": [
          {
            "company": "Acme",
            "id": 42,
            "location": "Remote",
            "posted_date": "2026-08-21",
            "source": {
              "code": "dou",
              "name": "DOU"
            },
            "title": "Python Developer",
            "url": "https://example.com/jobs/42"
          }
        ],
        "properties": {
          "id": {
            "description": "CareerLens vacancy identifier.",
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "description": "Vacancy title.",
            "title": "Title",
            "type": "string"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Company name, or null when unavailable.",
            "title": "Company"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Vacancy location, or null when unavailable.",
            "title": "Location"
          },
          "posted_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Source publication date, or null when unavailable.",
            "title": "Posted Date"
          },
          "source": {
            "$ref": "#/components/schemas/SourceOut",
            "description": "Vacancy source."
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Original vacancy URL, or null when unavailable.",
            "title": "Url"
          }
        },
        "required": [
          "id",
          "title",
          "company",
          "location",
          "posted_date",
          "source",
          "url"
        ],
        "title": "VacancyOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": [],
  "tags": [
    {
      "name": "accounts",
      "description": "Current-user session and account operations."
    },
    {
      "name": "feed",
      "description": "Vacancy feed operations."
    },
    {
      "name": "health",
      "description": "Public service health probes."
    }
  ]
}