{
  "openapi": "3.1.0",
  "info": {
    "title": "CareerLens API",
    "version": "1.0.0",
    "description": "Session-authenticated HTTP API for the CareerLens web application."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "api_health_health",
        "summary": "Health check probe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "error"
                }
              }
            }
          }
        },
        "description": "Unauthenticated probe for load balancers and uptime monitors. Returns 200 when the application and dependencies are healthy, 503 when unavailable.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "config_api_v1_accounts_me",
        "summary": "Current session user",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Ensures the CSRF cookie is available for subsequent state-changing requests.",
                "schema": {
                  "type": "string"
                },
                "example": "csrftoken=token; Path=/; SameSite=Lax"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Unauthorized"
                }
              }
            }
          }
        },
        "description": "Returns the profile of the currently authenticated user.\n\nAlso ensures the CSRF token is available: the response carries a\n`Set-Cookie: csrftoken` header that clients must store and echo back\nas `X-CSRFToken` on subsequent state-changing requests.",
        "tags": [
          "accounts"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/logout": {
      "post": {
        "operationId": "config_api_v1_accounts_logout",
        "summary": "Log out",
        "parameters": [
          {
            "in": "cookie",
            "name": "csrftoken",
            "schema": {
              "description": "CSRF cookie issued by GET /api/v1/me.",
              "title": "Csrftoken",
              "type": "string"
            },
            "required": true,
            "description": "CSRF cookie issued by GET /api/v1/me."
          },
          {
            "in": "header",
            "name": "X-CSRFToken",
            "schema": {
              "description": "Value matching the csrftoken cookie.",
              "title": "X-Csrftoken",
              "type": "string"
            },
            "required": true,
            "description": "Value matching the csrftoken cookie."
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the Django session cookie.",
                "schema": {
                  "type": "string"
                },
                "example": "sessionid=; Max-Age=0; Path=/; SameSite=Lax"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "CSRF check Failed"
                }
              }
            }
          }
        },
        "description": "Terminates the current authenticated session and clears the session cookie.\n\nRequires the `X-CSRFToken` header matching the `csrftoken` cookie value.",
        "tags": [
          "accounts"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/v1/feed": {
      "get": {
        "operationId": "config_api_v1_feed_feed",
        "summary": "List vacancies",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor returned by the previous response.",
              "title": "Cursor"
            },
            "required": false,
            "description": "Opaque cursor returned by the previous response."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "description": "Number of vacancies to return.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "required": false,
            "description": "Number of vacancies to return."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedOut"
                },
                "example": {
                  "items": [
                    {
                      "id": 42,
                      "title": "Python Developer",
                      "company": "Acme",
                      "location": "Remote",
                      "posted_date": "2026-08-21",
                      "scraped_at": "2026-08-21T10:30:00Z",
                      "source_updated_at": "2026-08-21T11:45:00Z",
                      "is_deftech": true,
                      "source": {
                        "code": "dou",
                        "name": "DOU",
                        "icon_url": "/source-icons/dou.png"
                      },
                      "url": "https://example.com/jobs/42",
                      "match": {
                        "score": 86,
                        "reason": "Strong Python and Django overlap.",
                        "evidence": {
                          "items": [
                            {
                              "type": "strong",
                              "label": "Python"
                            }
                          ]
                        },
                        "precise": true,
                        "scored_at": "2026-08-21T12:00:00Z"
                      }
                    }
                  ],
                  "next_cursor": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Unauthorized"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "description": "Returns vacancies in stable newest-first order.",
        "tags": [
          "feed"
        ],
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "examples": [
          {
            "status": "ok"
          }
        ],
        "properties": {
          "status": {
            "description": "Overall application and dependency health.",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeOut": {
        "examples": [
          {
            "avatar_url": "https://images.example.com/john.jpg",
            "email": "john.doe@example.com",
            "first_name": "John",
            "id": 1,
            "last_name": "Doe"
          }
        ],
        "properties": {
          "id": {
            "description": "CareerLens user identifier.",
            "title": "Id",
            "type": "integer"
          },
          "email": {
            "description": "Verified sign-in email address.",
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "description": "Given name, or an empty string when unavailable.",
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "description": "Family name, or an empty string when unavailable.",
            "title": "Last Name",
            "type": "string"
          },
          "avatar_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "WorkOS profile image URL, or null when unavailable.",
            "title": "Avatar Url"
          }
        },
        "required": [
          "id",
          "email",
          "first_name",
          "last_name",
          "avatar_url"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ErrorOut": {
        "examples": [
          {
            "detail": "Unauthorized"
          }
        ],
        "properties": {
          "detail": {
            "description": "Human-readable reason the request was rejected.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "FeedQuery": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque cursor returned by the previous response.",
            "title": "Cursor"
          },
          "limit": {
            "default": 20,
            "description": "Number of vacancies to return.",
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "FeedQuery",
        "type": "object"
      },
      "FeedOut": {
        "properties": {
          "items": {
            "description": "Vacancies in stable newest-first order.",
            "items": {
              "$ref": "#/components/schemas/VacancyOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque cursor for the next page, or null at the end.",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FeedOut",
        "type": "object"
      },
      "MatchOut": {
        "properties": {
          "score": {
            "description": "Personal match percentage.",
            "maximum": 100,
            "minimum": 0,
            "title": "Score",
            "type": "integer"
          },
          "reason": {
            "description": "Short explanation of the score.",
            "title": "Reason",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": true,
            "description": "Structured evidence supporting the score.",
            "title": "Evidence",
            "type": "object"
          },
          "precise": {
            "description": "Whether the score meets the precise-match evidence contract.",
            "title": "Precise",
            "type": "boolean"
          },
          "scored_at": {
            "description": "Time when this result was produced.",
            "format": "date-time",
            "title": "Scored At",
            "type": "string"
          }
        },
        "required": [
          "score",
          "reason",
          "evidence",
          "precise",
          "scored_at"
        ],
        "title": "MatchOut",
        "type": "object"
      },
      "SourceOut": {
        "properties": {
          "code": {
            "description": "Stable source code.",
            "title": "Code",
            "type": "string"
          },
          "name": {
            "description": "Human-readable source name.",
            "title": "Name",
            "type": "string"
          },
          "icon_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Source icon URL, or null when unavailable.",
            "title": "Icon Url"
          }
        },
        "required": [
          "code",
          "name",
          "icon_url"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "VacancyOut": {
        "examples": [
          {
            "company": "Acme",
            "id": 42,
            "is_deftech": true,
            "location": "Remote",
            "match": {
              "evidence": {
                "items": [
                  {
                    "label": "Python",
                    "type": "strong"
                  }
                ]
              },
              "precise": true,
              "reason": "Strong Python and Django overlap.",
              "score": 86,
              "scored_at": "2026-08-21T12:00:00Z"
            },
            "posted_date": "2026-08-21",
            "scraped_at": "2026-08-21T10:30:00Z",
            "source": {
              "code": "dou",
              "icon_url": "/source-icons/dou.png",
              "name": "DOU"
            },
            "source_updated_at": "2026-08-21T11:45:00Z",
            "title": "Python Developer",
            "url": "https://example.com/jobs/42"
          }
        ],
        "properties": {
          "id": {
            "description": "CareerLens vacancy identifier.",
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "description": "Vacancy title.",
            "title": "Title",
            "type": "string"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Company name, or null when unavailable.",
            "title": "Company"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Vacancy location, or null when unavailable.",
            "title": "Location"
          },
          "posted_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Source publication date, or null when unavailable.",
            "title": "Posted Date"
          },
          "scraped_at": {
            "description": "Time when CareerLens imported the vacancy.",
            "format": "date-time",
            "title": "Scraped At",
            "type": "string"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last source update time, or null when unavailable.",
            "title": "Source Updated At"
          },
          "is_deftech": {
            "description": "Whether the vacancy or its company is classified as DefTech.",
            "title": "Is Deftech",
            "type": "boolean"
          },
          "source": {
            "$ref": "#/components/schemas/SourceOut",
            "description": "Vacancy source."
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Original vacancy URL, or null when unavailable.",
            "title": "Url"
          },
          "match": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatchOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Current user's match result, or null when not scored."
          }
        },
        "required": [
          "id",
          "title",
          "company",
          "location",
          "posted_date",
          "scraped_at",
          "source_updated_at",
          "is_deftech",
          "source",
          "url",
          "match"
        ],
        "title": "VacancyOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": [],
  "tags": [
    {
      "name": "accounts",
      "description": "Current-user session and account operations."
    },
    {
      "name": "feed",
      "description": "Vacancy feed operations."
    },
    {
      "name": "health",
      "description": "Public service health probes."
    }
  ]
}