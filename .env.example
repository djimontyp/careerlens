COMPOSE_PROJECT_NAME=careerlens-release-dev
CAREERLENS_HTTP_PORT=9090
CAREERLENS_FRONTEND_PORT=5173
CAREERLENS_DEV_DB_PORT=5433
DOCKER_CONTEXT=

APP__ENVIRONMENT=development
APP__DJANGO__DEBUG=true
APP__DJANGO__SECRET_KEY=dev-secret-key-with-at-least-32-characters-long
APP__DJANGO__ALLOWED_HOSTS=["localhost","127.0.0.1","app"]
APP__DEV__AUTOLOGIN=true
APP__CORE__SITE_URL=http://localhost:5173
APP__AUTH__WORKOS__ENABLED=false
APP__AUTH__WORKOS__CLIENT_ID=
APP__AUTH__WORKOS__API_KEY=
APP__AUTH__WORKOS__REDIRECT_URI=http://localhost:5173/callback/
APP__DATABASE__DATABASE=careerlens_dev
APP__DATABASE__USER=careerlens_dev
APP__DATABASE__PASSWORD=careerlens_dev_password
APP__DATABASE__HOST=127.0.0.1
APP__DATABASE__PORT=5433
